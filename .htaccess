RewriteEngine On

# Uma unica versao publica para evitar duplicidade de indexacao.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} ^www\.techsantos\.com\.br$ [NC]
RewriteRule ^ https://techsantos.com.br%{REQUEST_URI} [R=301,L]

# A home canonica nao inclui index.html.
RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
RewriteRule ^index\.html$ https://techsantos.com.br/ [R=301,L]
RedirectMatch 301 ^/assets/social-video/(.+)$ https://media.techsantos.com.br/reels/$1
RedirectMatch 301 ^/assets/videos-preview/(.+)$ https://media.techsantos.com.br/previews/$1
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>
